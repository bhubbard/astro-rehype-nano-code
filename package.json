{
  "name": "astro-rehype-nano-code",
  "version": "0.1.0",
  "description": "Astro integration and Rehype plugin for on-demand local AI code explanations powered by Chrome Built-in AI (Gemini Nano) with zero initial JS bloat",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./rehype": {
      "types": "./dist/rehype-plugin.d.ts",
      "import": "./dist/rehype-plugin.js",
      "default": "./dist/rehype-plugin.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/client.ts src/rehype-plugin.ts --outdir ./dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "rehype",
    "rehype-plugin",
    "chrome-ai",
    "gemini-nano",
    "built-in-ai",
    "prompt-api",
    "code-explainer",
    "syntax-highlighting",
    "markdown",
    "web-components"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "dependencies": {
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "@types/unist": "^3.0.3",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  }
}
